# SentinalBrand frontend-safe Supabase configuration.
# Use the project URL and anon/publishable key from Supabase project settings.
# NEVER place the service_role key in a VITE_ variable or commit it to GitHub.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Optional AI Studio / deployment variables retained from the original prototype.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
